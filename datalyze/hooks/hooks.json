{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_datalyze_playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/datalyze.js\" capture hook pre",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "if grep -Eq 'verify[^A-Za-z0-9 ]{1,3}local'; then echo 'Refused by Datalyze: .datalyze/verify.local.yaml holds test-account secrets, and Claude never reads them. setup_verify says which secrets are set, by name.' >&2; exit 2; fi; exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Task|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/datalyze.js\" progress pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_datalyze_playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/datalyze.js\" capture hook post",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Task|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/datalyze.js\" progress post",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/datalyze.js\" capture hook prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
